# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:5000

# 🌐 Public Web Portal URL (For QR Codes, Links & Live Tracking)
VITE_PUBLIC_PORTAL_URL=https://indo-fleet.vercel.app

# 📞 Support & Operations Contact
VITE_SUPPORT_EMAIL=connect@indowings.com
VITE_SUPPORT_PHONE=1800 572 7363

# 👤 Demo Quick-Login Credentials (Command Center)
VITE_DEMO_ADMIN_EMAIL=admin@example.com
VITE_DEMO_ADMIN_NAME=Administrator

# 🗺️ Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# 🔥 Firebase Phone OTP Authentication & Push Notifications
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
