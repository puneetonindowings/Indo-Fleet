PORT=5000

# Supabase project URL and keys
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Auth Secret
JWT_SECRET=replace-with-a-long-random-secret

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# -------------------------------------------------------------
# 📧 EMAIL OTP & NOTIFICATIONS (Gmail SMTP via Nodemailer)
# Generate 16-character App Password at: https://myaccount.google.com/apppasswords
# -------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password

# Optional: Resend API (Alternative email gateway)
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev

# -------------------------------------------------------------
# 🔥 FIREBASE (Phone OTP & FCM Push Notifications)
# Download Service Account Key JSON at:
# https://console.firebase.google.com/project/_/settings/serviceaccounts/adminsdk
# -------------------------------------------------------------
# Option 1: Individual keys
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option 2: Path to downloaded JSON file (e.g. ./firebase-service-account.json)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Option 3: Raw JSON string of the service account
FIREBASE_SERVICE_ACCOUNT_JSON=

# -------------------------------------------------------------
# 🗺️ GOOGLE MAPS API KEY (For Geocoding & Route Distance)
# Get from: https://console.cloud.google.com/google/maps-apis/credentials
# -------------------------------------------------------------
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Public frontend origin
FRONTEND_URL=http://localhost:5173
