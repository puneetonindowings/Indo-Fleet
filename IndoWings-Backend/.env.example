PORT=5000

# Supabase project URL and public anon key (used by frontend only).
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Required for trusted backend database access because the schema enables RLS without anon policies.
# Keep this server-only; never expose it in frontend/VITE_ variables or share it publicly.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# Use a unique, high-entropy secret in real deployments.
JWT_SECRET=replace-with-a-long-random-secret

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

RESEND_API_KEY=
FROM_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Separate Supabase project used by the existing SMS OTP integration, if enabled.
SERVICEHUB_SUPABASE_URL=
SERVICEHUB_SUPABASE_ANON_KEY=
FAST2SMS_API_KEY=

# Public frontend origin used in account and booking emails.
FRONTEND_URL=http://localhost:3000
